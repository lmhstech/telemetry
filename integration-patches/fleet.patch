@@ -0,0 +1,98 @@
+// Telemetry reporter for Cloudflare Workers.
+//
+// Drop this file into a Worker's src/lib/, set the TELEMETRY_KEY secret, and
+// wrap the fetch handler.
+//
+// THE ONE RULE: reporting must never make the host app worse. Every failure
+// path here ends in a swallowed error. A telemetry service that is down, slow,
+// or misconfigured must be invisible to a student loading a page.
+
+const ENDPOINT = 'https://telemetry.lmhstech.com/api/ingest';
+
+/**
+ * Scrub before sending.
+ *
+ * The service scrubs again on arrival — this is not redundant, it is the
+ * difference between "personal data was redacted" and "personal data was never
+ * transmitted". Only the second one is true data minimisation.
+ */
+function scrub(text) {
+  return String(text ?? '')
+    .replace(/[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}/g, '[email]')
+    .replace(/\beyJ[A-Za-z0-9_-]{4,}\.[A-Za-z0-9_-]{4,}\.[A-Za-z0-9_-]*/g, '[jwt]')
+    .replace(/\b(?:Bearer|Basic)\s+[A-Za-z0-9._~+/=-]{12,}/gi, '[credential]')
+    .replace(/\b\d{6,}\b/g, '[number]')
+    .replace(/(\/(?:Users|home)\/)[^/\s"']+/g, '$1[user]');
+}
+
+/**
+ * Send one report. Fire-and-forget: pass ctx so it runs after the response.
+ *
+ * @param {object} env  must contain TELEMETRY_KEY
+ * @param {object} ctx  the Worker execution context (for waitUntil)
+ */
+export function report(env, ctx, error, extra = {}) {
+  if (!env?.TELEMETRY_KEY) return; // not configured — stay silent, do nothing
+
+  const body = JSON.stringify({
+    message: scrub(error?.message || String(error)).slice(0, 2000),
+    stack: scrub(error?.stack || '').slice(0, 8000) || undefined,
+    level: extra.level || 'error',
+    environment: env.ENVIRONMENT || 'production',
+    release: env.RELEASE || undefined,
+    fingerprint: extra.fingerprint,
+    context: extra.context,
+    occurred_at: Math.floor(Date.now() / 1000),
+  });
+
+  const send = fetch(ENDPOINT, {
+    method: 'POST',
+    headers: {
+      'Content-Type': 'application/json',
+      Authorization: `Bearer ${env.TELEMETRY_KEY}`,
+    },
+    body,
+  }).catch(() => {}); // a telemetry outage is not this app's problem
+
+  if (ctx?.waitUntil) ctx.waitUntil(send);
+}
+
+/**
+ * Wrap a Worker's fetch handler so anything that escapes it is reported.
+ *
+ * Usage:
+ *   import { withTelemetry } from './lib/telemetry.js';
+ *   export default withTelemetry({
+ *     async fetch(request, env, ctx) { ... },
+ *   });
+ *
+ * The original error is always re-thrown. This observes; it does not swallow.
+ */
+export function withTelemetry(handler) {
+  return {
+    ...handler,
+    async fetch(request, env, ctx) {
+      try {
+        return await handler.fetch(request, env, ctx);
+      } catch (err) {
+        const url = new URL(request.url);
+        report(env, ctx, err, {
+          context: { path: url.pathname, method: request.method },
+        });
+        throw err;
+      }
+    },
+    ...(handler.scheduled
+      ? {
+          async scheduled(event, env, ctx) {
+            try {
+              return await handler.scheduled(event, env, ctx);
+            } catch (err) {
+              report(env, ctx, err, { context: { cron: event.cron }, level: 'error' });
+              throw err;
+            }
+          },
+        }
+      : {}),
+  };
+}
