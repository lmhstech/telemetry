{
  "name": "lmhs-telemetry",
  "version": "1.0.0",
  "private": true,
  "description": "telemetry.lmhstech.com - error reporting and AI issue triage for the LMHS Tech estate",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "login": "wrangler login",
    "whoami": "wrangler whoami",
    "db:create": "wrangler d1 create lmhs-telemetry",
    "migrate:local": "wrangler d1 migrations apply lmhs-telemetry --local",
    "migrate:remote": "wrangler d1 migrations apply lmhs-telemetry --remote",
    "tail": "wrangler tail",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "wrangler": "^4.119.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
